    },
    {
      "when": { "level": 5, "floating": false },
      "apply": { "model": "bittermelon:block/fluid/fluid_4" }
    },
    {
      "when": { "level": 6, "floating": false },
      "apply": { "model": "bittermelon:block/fluid/fluid_5" }
    },
    {
      "when": { "level": 7, "floating": false },
